# Copy this file to .env and fill in your own values:  copy .env.example .env

# Port the API listens on. On Render this is set automatically for you.
PORT=3000

# PostgreSQL connection string (from your Render managed database)
DATABASE_URL=postgresql://postgres:your-database-password@your-host:5432/safargo

# A long random string used to sign admin login tokens.
# In production it must be at least 32 characters.
# NEVER put a real secret in .env.example
JWT_SECRET=change-me-to-a-long-random-string

# The URL of your frontend. The API only accepts requests from this origin.
FRONTEND_URL=http://localhost:5173

# development or production. In production the API refuses to start
# if JWT_SECRET is missing, too short, or still the placeholder above.
NODE_ENV=development

# Admin session cookie settings (the defaults are fine for most deployments):
# COOKIE_SECURE=true|false  - default: true in production, false in development
# COOKIE_SAME_SITE=strict   - default: strict (options: strict, lax)
