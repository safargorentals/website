# Copy this file to .env and fill in your own values:  copy .env.example .env

# Port the API listens on. On Render this is set automatically for you.
PORT=3000

# PostgreSQL connection string (from your Render managed database)
DATABASE_URL=postgresql://postgres:your-database-password@your-host:5432/safargo

# A long random string used to sign admin login tokens.
# In production it must be at least 32 characters.
# NEVER put a real secret in .env.example
JWT_SECRET=change-me-to-a-long-random-string

# The URL(s) of your frontend. Use one or several comma-separated origins;
# the API only accepts browser requests from those EXACT origins (CORS).
# Examples:
#   FRONTEND_URL=http://localhost:5173
#   FRONTEND_URL=http://localhost:5173,https://safargo.com
FRONTEND_URL=http://localhost:5173

# development or production. In production the API refuses to start
# if JWT_SECRET is missing, too short, or still the placeholder above.
NODE_ENV=development

# Number of proxies in front of the API (default 1 = Render only).
# Set to 2 when the frontend is on Netlify and Netlify proxies /api here.
# TRUST_PROXY_HOPS=1

# Admin session cookie settings (the defaults are fine for most deployments):
# COOKIE_SECURE=true|false  - default: true in production, false in development
# COOKIE_SAME_SITE=strict   - default: strict (options: strict, lax)

# Cloudinary image uploads (admin only). Copy these from your Cloudinary dashboard.
# NEVER put real secrets in .env.example
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# New-enquiry email alerts (via Resend). If these are missing, emails are
# skipped with a one-line log and enquiries still save normally.
# NEVER put a real API key in .env.example
RESEND_API_KEY=re_your-api-key
NOTIFY_EMAIL_TO=owner@example.com
NOTIFY_EMAIL_FROM=Drive Kochi <noreply@example.com>

# Base URL of the admin panel, used to link new enquiries in the email
ADMIN_URL=http://localhost:5173
