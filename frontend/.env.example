# Base URL of the backend API. Leave empty in development (Vite proxies /api
# to http://localhost:3000). In production, e.g. https://api.safargo.com
VITE_API_URL=

# Business contact number shown in the hero banner and header
VITE_CONTACT_PHONE=+91 98765 43210

# Optional WhatsApp number (digits only, with country code) for the floating button
VITE_WHATSAPP_NUMBER=919876543210

# Site address for the canonical URL, link previews and sitemap (used by
# scripts/prerender.js at build time). On Netlify leave it unset: Netlify
# provides the site's address as URL during builds. Set it only to use a
# different address, e.g. https://drivekochi.com
SITE_URL=
