# Base URL of the backend API. Leave empty in development (Vite proxies /api
# to http://localhost:3000). In production, e.g. https://api.safargo.com
VITE_API_URL=

# Business contact number shown in the hero banner and header
VITE_CONTACT_PHONE=+92 300 0000000

# Optional WhatsApp number (digits only, with country code) for the floating button
VITE_WHATSAPP_NUMBER=923000000000
